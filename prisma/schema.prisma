generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//
// ✅ Normalized tables managed by Prisma
//
model Painting {
  id         Int         @id
  title      String?
  imgSrc     String?
  season     Int?
  episode    Int?
  youtubeSrc String?
  colors     ColorUsed[]
}

model ColorName {
  id     Int         @id @default(autoincrement())
  name   String      @unique
  usedBy ColorUsed[]
}

model ColorUsed {
  id          Int       @id @default(autoincrement())
  painting    Painting  @relation(fields: [paintingId], references: [id])
  paintingId  Int
  colorName   ColorName @relation(fields: [colorNameId], references: [id])
  colorNameId Int
}

//
// 🔒 Existing tables from CSV imports — ignored during migration
//

model rawcolorsused {
  idrow Int @id

  @@map("colorsused")
  @@ignore
}

model episodedates {
  idrow Int @id

  @@ignore
}

model subjectMatter {
